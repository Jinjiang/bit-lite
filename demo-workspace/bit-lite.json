{
  "defaultEnv": "node",
  "envs": {
    "node": {
      "services": {
        "inspect": {
          "vendor": "default",
          "config": {
            "label": "node components"
          }
        },
        "typescript": {
          "vendor": "tsc",
          "config": {
            "tsconfig": "tsconfig.json"
          }
        },
        "test": {
          "vendor": "vitest",
          "config": {
            "args": ["run"]
          }
        },
        "preview": {
          "vendor": "vite",
          "config": {
            "framework": "html"
          }
        }
      }
    },
    "react": {
      "extends": "node",
      "services": {
        "inspect": {
          "vendor": "default",
          "config": {
            "label": "react components"
          }
        },
        "preview": {
          "vendor": "vite",
          "config": {
            "framework": "react"
          }
        }
      }
    }
  },
  "components": {
    "components/lib/**": "node",
    "components/ui/**": "react"
  }
}
