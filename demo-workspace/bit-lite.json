{
  "defaultEnv": "node",
  "envs": {
    "node": {
      "services": {
        "inspect": {
          "vendor": "default",
          "config": {
            "label": "node components"
          }
        },
        "typescript": {
          "vendor": "tsc",
          "config": {
            "tsconfig": "tsconfig.json"
          }
        },
        "test": {
          "vendor": "jest",
          "config": {}
        },
        "preview": {
          "vendor": "webpack",
          "config": {
            "configFile": "preview/webpack.node.config.mjs"
          }
        }
      }
    },
    "react": {
      "extends": "node",
      "services": {
        "inspect": {
          "vendor": "summary",
          "config": {
            "label": "react components"
          }
        },
        "preview": {
          "vendor": "vite",
          "config": {
            "configFile": "preview/vite.react.config.mjs"
          }
        },
        "test": {
          "vendor": "mocha",
          "config": {}
        }
      }
    },
    "vue": {
      "extends": "node",
      "services": {
        "inspect": {
          "vendor": "summary",
          "config": {
            "label": "vue components"
          }
        },
        "typescript": {
          "vendor": "tsgo",
          "config": {
            "tsconfig": "tsconfig.json"
          }
        },
        "test": {
          "vendor": "vitest",
          "config": {
            "args": ["run"]
          }
        },
        "preview": {
          "vendor": "webpack",
          "config": {
            "configFile": "preview/webpack.vue.config.mjs"
          }
        }
      }
    }
  },
  "components": {
    "components/lib/**": "node",
    "components/ui/**": "react",
    "components/vue/**": "vue"
  }
}
