{
  "defaultEnv": "node",
  "envs": {
    "node": {
      "services": {
        "inspect": {
          "label": "node components"
        },
        "typescript": {
          "tsconfig": "tsconfig.json"
        },
        "test": {
          "args": ["run"]
        },
        "preview": {
          "framework": "html",
          "port": 3101,
          "centralPort": 3000
        }
      }
    },
    "react": {
      "extends": "node",
      "services": {
        "inspect": {
          "label": "react components"
        },
        "preview": {
          "framework": "react",
          "port": 3102,
          "centralPort": 3000
        }
      }
    }
  },
  "components": {
    "components/lib/**": "node",
    "components/ui/**": "react"
  }
}
