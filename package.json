{
  "name": "bit-lite",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "bin": {
    "bit-lite": "dist/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "demo:components": "tsx src/index.ts --workspace demo-workspace components",
    "demo:envs": "tsx src/index.ts --workspace demo-workspace envs",
    "demo:inspect": "tsx src/index.ts --workspace demo-workspace run inspect",
    "demo:typescript": "tsx src/index.ts --workspace demo-workspace run typescript",
    "demo:test": "tsx src/index.ts --workspace demo-workspace run test",
    "demo:test:watch": "tsx src/index.ts --workspace demo-workspace run test --watch",
    "demo:preview": "tsx src/index.ts --workspace demo-workspace run preview",
    "demo:start": "tsx src/index.ts --workspace demo-workspace start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
