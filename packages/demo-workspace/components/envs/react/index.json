{
  "name": "@my-scope/env.react",
  "extends": "demo-env-node",
  "services": {
    "test": {
      "vendor": "demo-vendors/testers/jest",
      "config": {
        "configFile": "demo-config/testers/jest/react"
      }
    },
    "preview": {
      "vendor": "demo-vendors/previewers/webpack",
