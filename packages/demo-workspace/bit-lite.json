{
  "defaultScope": "my-scope",
  "envs": {
    "node": {
      "services": {
        "foo": {
          "vendor": "x",
          "config": {
            "label": "node foo",
            "delay": 5
          }
        },
        "test": {
          "vendor": "demo-vendors/testers/vitest",
          "config": {
            "configFile": "demo-config/testers/vitest/node"
          }
        },
        "bar": {
          "vendor": "y",
          "config": {
            "label": "node bar"
          }
        }
      }
    },
    "react": {
      "extends": "node",
      "services": {
        "bar": {
          "vendor": "x",
          "config": {
            "label": "react bar",
            "delay": 15
          }
        },
        "baz": {
          "vendor": "x",
          "config": {
            "label": "react baz"
          }
        },
        "test": {
          "vendor": "demo-vendors/testers/jest",
          "config": {
            "configFile": "demo-config/testers/jest/react"
          }
        }
      }
    },
    "vue": {
      "extends": "node",
      "services": {
        "bar": {
          "vendor": "z",
          "config": {
            "label": "vue bar",
            "delay": 20
          }
        },
        "test": {
          "vendor": "demo-vendors/testers/vitest",
          "config": {
            "configFile": "demo-config/testers/vitest/vue"
          }
        }
      }
    }
  },
  "components": [
    {
      "path": "components/lib/math",
      "id": "lib/math",
      "packageName": "@my-scope/lib.math",
      "env": {
        "packageName": "demo-config",
        "version": "workspace:*"
      }
    },
    {
      "path": "components/ui/button",
      "id": "ui/button",
      "packageName": "@my-scope/ui.button",
      "env": {
        "packageName": "demo-config",
        "version": "workspace:*"
      }
    },
    {
      "path": "components/vue/card",
      "id": "vue/card",
      "packageName": "@my-scope/vue.card",
      "env": {
        "packageName": "demo-config",
        "version": "workspace:*"
      }
    }
  ]
}
