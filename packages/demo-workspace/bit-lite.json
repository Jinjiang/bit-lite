{
  "envs": {
    "node": {
      "services": {
        "foo": {
          "vendor": "x",
          "config": {
            "label": "node foo",
            "delay": 5
          }
        },
        "test": {
          "vendor": "bit-lite-vendors/sample/test-x",
          "config": {
            "label": "node test",
            "shard": "unit",
            "retries": 1,
            "coverage": true
          }
        },
        "bar": {
          "vendor": "y",
          "config": {
            "label": "node bar"
          }
        }
      }
    },
    "react": {
      "extends": "node",
      "services": {
        "bar": {
          "vendor": "x",
          "config": {
            "label": "react bar",
            "delay": 15
          }
        },
        "baz": {
          "vendor": "x",
          "config": {
            "label": "react baz"
          }
        },
        "test": {
          "vendor": "bit-lite-vendors/sample/test-y",
          "config": {
            "label": "react test",
            "shard": "browser",
            "retries": 2,
            "coverage": false
          }
        }
      }
    },
    "vue": {
      "extends": "node",
      "services": {
        "bar": {
          "vendor": "z",
          "config": {
            "label": "vue bar",
            "delay": 20
          }
        },
        "test": {
          "vendor": "bit-lite-vendors/sample/test-x",
          "config": {
            "label": "vue test",
            "shard": "sfc",
            "retries": 1,
            "coverage": true
          }
        }
      }
    }
  },
  "components": {
    "components/lib/math": "node",
    "components/ui/button": "react",
    "components/vue/card": "vue"
  }
}
