    "@pnpm/types": "1001.3.0",
    "@pnpm/worker": "1000.6.7",
    "bit-lite-utils": "workspace:*",
    "fast-glob": "^3.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
