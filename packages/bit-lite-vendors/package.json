{
  "name": "bit-lite-vendors",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./foo-x": {
      "types": "./src/foo-x.ts",
      "default": "./dist/foo-x.js"
    },
    "./bar-x": {
      "types": "./src/bar-x.ts",
      "default": "./dist/bar-x.js"
    },
    "./bar-y": {
      "types": "./src/bar-y.ts",
      "default": "./dist/bar-y.js"
    },
    "./bar-z": {
      "types": "./src/bar-z.ts",
      "default": "./dist/bar-z.js"
    },
    "./baz-x": {
      "types": "./src/baz-x.ts",
      "default": "./dist/baz-x.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "pnpm --filter bit-lite-runner build && tsc -p tsconfig.json"
  },
  "dependencies": {
    "bit-lite-context": "workspace:*",
    "bit-lite-runner": "workspace:*",
    "bit-lite-terminal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
