{
  "name": "bit-lite-vendors",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./runner": {
      "types": "./src/runner/index.ts",
      "default": "./dist/runner/index.js"
    },
    "./vendor-task": {
      "types": "./src/vendor-task.ts",
      "default": "./dist/vendor-task.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bit-lite-context": "workspace:*",
    "bit-lite-terminal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
