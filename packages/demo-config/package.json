{
  "name": "demo-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./previewers/react-mounter": {
      "types": "./src/previewers/react-mounter.ts",
      "default": "./dist/previewers/react-mounter.js"
    },
    "./previewers/static-mounter": {
      "types": "./src/previewers/static-mounter.ts",
      "default": "./dist/previewers/static-mounter.js"
    },
    "./previewers/vite-static": {
      "types": "./src/previewers/vite-static.ts",
      "default": "./dist/previewers/vite-static.js"
    },
    "./previewers/vite-vue": {
      "types": "./src/previewers/vite-vue.ts",
      "default": "./dist/previewers/vite-vue.js"
    },
    "./previewers/webpack-react": {
      "types": "./src/previewers/webpack-react.ts",
      "default": "./dist/previewers/webpack-react.js"
    },
    "./previewers/vue-mounter": {
      "types": "./src/previewers/vue-mounter.ts",
      "default": "./dist/previewers/vue-mounter.js"
    },
    "./testers/jest/react": {
      "types": "./src/testers/jest/react/jest.config.ts",
      "default": "./dist/testers/jest/react/jest.config.js"
    },
    "./testers/vitest/node": {
      "types": "./src/testers/vitest/node/vitest.config.ts",
      "default": "./dist/testers/vitest/node/vitest.config.js"
    },
    "./testers/vitest/vue": {
      "types": "./src/testers/vitest/vue/vitest.config.ts",
      "default": "./dist/testers/vitest/vue/vitest.config.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "jest-environment-jsdom": "^30.4.1",
    "swc-loader": "^0.2.6",
    "vite": "^8.1.2"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jest": "^30.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vue": "^3.5.38"
  }
}
