{
  "name": "bit-lite-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter bit-lite-terminal build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter bit-lite-terminal build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bit-lite-terminal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
