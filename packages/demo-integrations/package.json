{
  "name": "demo-integrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "pnpm --filter bit-lite-runner build && tsc -p tsconfig.json",
    "start": "pnpm run build && node dist/main.js",
    "start:worker": "pnpm run build && node dist/main.js --runner=worker",
    "start:inline": "pnpm run build && node dist/main.js --runner=inline",
    "typecheck": "pnpm --filter bit-lite-runner build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bit-lite-runner": "workspace:*",
    "bit-lite-terminal": "workspace:*",
    "jest": "^30.4.2",
    "vite": "^8.1.2",
    "vitest": "^4.1.9",
    "webpack": "^5.108.3",
    "webpack-dev-server": "^5.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
