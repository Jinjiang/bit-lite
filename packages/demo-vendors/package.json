{
  "name": "demo-vendors",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./bar-x": {
      "types": "./src/samples/bar-x.ts",
      "default": "./dist/samples/bar-x.js"
    },
    "./bar-y": {
      "types": "./src/samples/bar-y.ts",
      "default": "./dist/samples/bar-y.js"
    },
    "./bar-z": {
      "types": "./src/samples/bar-z.ts",
      "default": "./dist/samples/bar-z.js"
    },
    "./baz-x": {
      "types": "./src/samples/baz-x.ts",
      "default": "./dist/samples/baz-x.js"
    },
    "./foo-x": {
      "types": "./src/samples/foo-x.ts",
      "default": "./dist/samples/foo-x.js"
    },
    "./mixed-results": {
      "types": "./src/samples/mixed-results.ts",
      "default": "./dist/samples/mixed-results.js"
    },
    "./test-x": {
      "types": "./src/samples/test-x.ts",
      "default": "./dist/samples/test-x.js"
    },
    "./test-y": {
      "types": "./src/samples/test-y.ts",
      "default": "./dist/samples/test-y.js"
    },
    "./testers/jest": {
      "types": "./src/testers/jest/index.ts",
      "default": "./dist/testers/jest/index.js"
    },
    "./previewers/vite": {
      "types": "./src/previewers/vite/index.ts",
      "default": "./dist/previewers/vite/index.js"
    },
    "./previewers/webpack": {
      "types": "./src/previewers/webpack/index.ts",
      "default": "./dist/previewers/webpack/index.js"
    },
    "./testers/vitest": {
      "types": "./src/testers/vitest/index.ts",
      "default": "./dist/testers/vitest/index.js"
    },
    "./test-result": {
      "types": "./src/samples/test-result.ts",
      "default": "./dist/samples/test-result.js"
    },
    "./compilers/typescript": {
      "types": "./src/compilers/typescript/index.ts",
      "default": "./dist/compilers/typescript/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bit-lite-context": "workspace:*",
    "bit-lite-preview": "workspace:*",
    "bit-lite-vendors": "workspace:*",
    "jest": "^30.4.2",
    "vite": "^8.1.2",
    "webpack": "^5.0.0",
    "webpack-dev-middleware": "^7.0.0",
    "webpack-hot-middleware": "^2.26.1",
    "vitest": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/webpack-hot-middleware": "^2.25.10",
    "typescript": "^6.0.3"
  }
}
