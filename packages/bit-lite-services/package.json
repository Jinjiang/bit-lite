{
  "name": "bit-lite-services",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "pnpm --filter bit-lite-vendors build && vitest run",
    "build": "pnpm --filter bit-lite-vendors build && tsc -p tsconfig.json"
  },
  "dependencies": {
    "bit-lite-context": "workspace:*",
    "bit-lite-runner": "workspace:*",
    "bit-lite-terminal": "workspace:*",
    "bit-lite-vendors": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
